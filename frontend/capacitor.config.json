{
  "appId": "com.bullrealboss.crm",
  "appName": "BullVet",
  "webDir": "dist",
  "server": {
    "androidScheme": "http"
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "SplashScreen": {
      "launchShowDuration": 3000,
      "launchAutoHide": true,
      "backgroundColor": "#ffffffff",
      "showSpinner": true
    }
  }
}
